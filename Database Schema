-- SQLite (swap types for Postgres / MySQL as needed)
CREATE TABLE events (
 id INTEGER PRIMARY KEY AUTOINCREMENT,
 idempotency_key TEXT NOT NULL UNIQUE, -- SHA-256 of canonical fields
 client_id TEXT NOT NULL,
 metric TEXT,
 amount REAL,
 timestamp TEXT, -- ISO-8601, UTC
 raw TEXT, -- original JSON blob
 received_at TEXT DEFAULT (datetime('now')),
 status TEXT DEFAULT 'processed' -- processed | rejected
);
CREATE INDEX idx_events_client ON events (client_id);
CREATE INDEX idx_events_ts ON events (timestamp);
CREATE INDEX idx_events_status ON events (status);
-- Rejected / failed events land here instead
CREATE TABLE rejected_events (
 id INTEGER PRIMARY KEY AUTOINCREMENT,
 raw TEXT,
 reason TEXT,
 received_at TEXT DEFAULT (datetime('now'))
);
