<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <title>Event Ingestion Dashboard</title>
 <style>
 * { box-sizing: border-box; font-family: system-ui, sans-serif; }
 body { margin: 0; background: #f0f2f5; color: #1a1a2e; }
 header { background: #1a1a2e; color: #fff; padding: 16px 24px; }
 header h1 { margin: 0; font-size: 1.3rem; }
 .container { max-width: 1000px; margin: 24px auto; padding: 0 16px; }
 .card { background: #fff; border-radius: 10px; padding: 20px;
 margin-bottom: 20px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
 h2 { margin: 0 0 14px; font-size: 1rem; color: #0f3460; }
 textarea { width: 100%; height: 130px; font-family: monospace;
 font-size: .85rem; border: 1px solid #ccd; border-radius: 6px;
 padding: 10px; resize: vertical; }
 .row { display: flex; gap: 10px; align-items: center; margin-top: 10px; }
 button { padding: 9px 20px; background: #0f3460; color: #fff;
 border: none; border-radius: 6px; cursor: pointer; font-size: .9rem; }
 button:hover { background: #16213e; }
 label { display: flex; align-items: center; gap: 6px; font-size: .9rem; cursor: pointer; }
 #status { margin-top: 10px; padding: 8px 12px; border-radius: 6px;
 font-size: .85rem; display: none; }
 .ok { background: #e8f5e9; color: #2e7d32; }
 .err { background: #fce4ec; color: #b71c1c; }
 table { width: 100%; border-collapse: collapse; font-size: .83rem; }
 th { background: #f4f6f8; padding: 8px; text-align: left;
 border-bottom: 2px solid #e0e0e0; }
 td { padding: 7px 8px; border-bottom: 1px solid #eee; vertical-align: top; }
 tr:hover td { background: #fafbff; }
 .badge { display: inline-block; padding: 2px 8px; border-radius: 12px;
 font-size: .75rem; font-weight: 600; }
 .badge-ok { background: #c8e6c9; color: #1b5e20; }
 .badge-rej { background: #ffcdd2; color: #b71c1c; }
 </style>
</head>
<body>
<header><h1>&#x26A1; Fault-Tolerant Event Dashboard</h1></header>
<div class="container">
 <!-- Submission card -->
 <div class="card">
 <h2>Submit Raw Event</h2>
 <textarea id="payload">{
 "source": "client_A",
 "payload": {
 "metric": "revenue",
 "amount": "1200",
 "timestamp": "2024/01/15"
 }
}</textarea>
 <div class="row">
 <button onclick="submitEvent()">Send Event</button>
 <label>
 <input type="checkbox" id="simFail"> Simulate DB Failure
 </label>
 </div>
 <div id="status"></div>
 </div>
 <!-- Processed events -->
 <div class="card">
 <h2>&#x2705; Processed Events <button style="float:right;padding:5px 12px"
 onclick="loadEvents()">Refresh</button></h2>
 <table id="proc-table">
 <thead><tr>
 <th>ID</th><th>Client</th><th>Metric</th>
 <th>Amount</th><th>Timestamp</th><th>Received</th>
 </tr></thead>
 <tbody id="proc-body"><tr><td colspan="6">Loading...</td></tr></tbody>
 </table>
 </div>
 <!-- Rejected events -->
 <div class="card">
 <h2>&#x274C; Rejected / Failed Events</h2>
 <table>
<thead><tr><th>ID</th><th>Reason</th><th>Raw</th><th>Received</th></tr></thead>
 <tbody id="rej-body"><tr><td colspan="4">Loading...</td></tr></tbody>
 </table>
 </div>
 <!-- Aggregates -->
 <div class="card">
 <h2>&#x1F4CA; Aggregates <button style="float:right;padding:5px 12px"
 onclick="loadAggregates()">Refresh</button></h2>
 <table>
 <thead><tr><th>Client</th><th>Metric</th><th>Count</th><th>Total</th></tr></thead>
 <tbody id="agg-body"><tr><td colspan="4">Loading...</td></tr></tbody>
 </table>
 </div>
</div>
<script>
const API = ""; // same origin; adjust if backend is on a different port
async function submitEvent() {
 const raw = document.getElementById("payload").value;
 const sim = document.getElementById("simFail").checked;
 const el = document.getElementById("status");
 el.style.display = "none";
 try {
 const res = await fetch(`${API}/ingest?simulate_failure=${sim}`, {
 method: "POST",
 headers: { "Content-Type": "application/json" },
 body: raw,
 });
 const data = await res.json();
 el.className = res.ok ? "ok" : "err";
 el.textContent = JSON.stringify(data, null, 2);
 el.style.display = "block";
 loadEvents(); loadAggregates();
 } catch(e) {
 el.className = "err";
 el.textContent = "Request failed: " + e.message;
 el.style.display = "block";
 }
}
async function loadEvents() {
 const res = await fetch(`${API}/events`);
 const data = await res.json();
 const pb = document.getElementById("proc-body");
 pb.innerHTML = data.processed.length === 0
 ? '<tr><td colspan="6">No events yet.</td></tr>'
 : data.processed.map(e => `<tr>
 <td>${e.id}</td><td>${e.client_id}</td><td>${e.metric||'—'}</td>
 <td>${e.amount??'—'}</td><td>${e.timestamp||'—'}</td>
 <td>${e.received_at}</td></tr>`).join("");
 const rb = document.getElementById("rej-body");
 rb.innerHTML = data.rejected.length === 0
 ? '<tr><td colspan="4">No rejections.</td></tr>'
 : data.rejected.map(r => `<tr>
 <td>${r.id}</td><td>${r.reason}</td>
 <td style="font-family:monospace;font-size:.75rem">${r.raw.slice(0,80)}…</td>
 <td>${r.received_at}</td></tr>`).join("");
}
async function loadAggregates() {
 const res = await fetch(`${API}/aggregates`);
 const data = await res.json();
 const ab = document.getElementById("agg-body");
 ab.innerHTML = data.length === 0
 ? '<tr><td colspan="4">No data.</td></tr>'
 : data.map(r => `<tr>
 <td>${r.client_id}</td><td>${r.metric||'—'}</td>
 <td>${r.count}</td><td>${r.total??'—'}</td></tr>`).join("");
}
loadEvents(); loadAggregates();
</script>
</body>
